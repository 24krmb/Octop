    {
      "kind": "weknora",
      "name": {
        "en": "WeKnora",
        "zh": "WeKnora"
      },
      "description": {
        "en": "Connect a private WeKnora knowledge base for read-only search and document reading",
        "zh": "连接 WeKnora 私有知识库，提供只读检索与文档阅读"
      },
      "auth_kind": "custom_fields",
      "doc_url": "https://github.com/Tencent/WeKnora",
      "icon": "weknora",
      "color": "#0052d9",
      "phase": "available",
      "mcp_mode": "gateway",
      "category": "knowledge",
      "guide_url": "https://github.com/Tencent/WeKnora/blob/main/docs/api/README.md",
      "auth_hint": {
        "en": "Enter the WeKnora service URL. Fill in API Key and Tenant ID according to your deployment’s auth settings.",
        "zh": "填写 WeKnora 服务地址；API Key 与 Tenant ID 按部署的鉴权设置填写。"
      },
      "credential_fields": [
        {
          "key": "base_url",
          "label": {
            "en": "Service URL",
            "zh": "服务地址"
          },
          "field_type": "url",
          "placeholder": {
            "en": "http://127.0.0.1:8080 or https://weknora.example.com",
            "zh": "http://127.0.0.1:8080 或 https://weknora.example.com"
          },
          "help": {
            "en": "Octop appends /api/v1 when the URL does not already include it",
            "zh": "未包含 /api/v1 时会自动补齐"
          }
        },
        {
          "key": "api_key",
          "label": {
            "en": "API Key",
            "zh": "API Key"
          },
          "field_type": "password",
          "required": false,
          "placeholder": {
            "en": "sk-... (leave empty if the deployment has no auth)",
            "zh": "sk-...（无鉴权部署可留空）"
          },
          "secret": true
        },
        {
          "key": "tenant_id",
          "label": {
            "en": "Tenant ID",
            "zh": "Tenant ID"
          },
          "required": false,
          "help": {
            "en": "Required when a platform-level API Key must target a workspace",
            "zh": "平台级 API Key 需要指定工作空间时填写"
          }
        },
        {
          "key": "knowledge_base_ids",
          "label": {
            "en": "Default knowledge-base IDs",
            "zh": "默认知识库 ID"
          },
          "field_type": "tags",
          "required": false,
          "placeholder": "kb-123, kb-456",
          "help": {
            "en": "Leave empty to search every knowledge base visible to this credential",
            "zh": "留空时检索当前凭证可见的全部知识库"
          }
        }
      ]
    },
